    // Add a simple test to verify the basic functionality
    public function test_location_has_coordinates_attribute(): void
    {
        $location = Location::factory()->create([
            'latitude' => -6.2293867,
            'longitude' => 106.8265753,
        ]);

        $this->assertEquals([
            'latitude' => -6.2293867,
            'longitude' => 106.8265753,
        ], $location->coordinates);
    }
