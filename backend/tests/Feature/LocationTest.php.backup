<?php

namespace Tests\Feature;

use App\Models\Location;
use App\Models\LocationAuditLog;
use App\Models\User;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Tests\TestCase;

class LocationTest extends TestCase
{
    use RefreshDatabase;

    public function test_locations_can_be_created(): void
    {
        $admin = User::factory()->create(['role' => 'admin']);

        $response = $this->actingAs($admin)->postJson('/api/locations', [
            'name' => 'Test Location',
            'code' => 'TEST001',
            'address' => 'Test Address',
            'latitude' => -6.2293867,
            'longitude' => 106.8265753,
            'radius_meters' => 100,
        ]);

        $response->assertStatus(201);
        $this->assertDatabaseHas('locations', [
            'name' => 'Test Location',
            'code' => 'TEST001',
        ]);
    }

    public function test_locations_can_be_listed(): void
    {
        $admin = User::factory()->create(['role' => 'admin']);
        Location::factory(3)->create();

        $response = $this->actingAs($admin)->getJson('/api/locations');

        $response->assertStatus(200);
        $response->assertJsonStructure([
            'success',
            'data',
            'total',
            'current_page',
            'last_page',
            'per_page',
        ]);
    }

    public function test_location_can_be_retrieved(): void
    {
        $admin = User::factory()->create(['role' => 'admin']);
        $location = Location::factory()->create();

        $response = $this->actingAs($admin)->getJson("/api/locations/{$location->id}");

        $response->assertStatus(200);
        $response->assertJson([
            'success' => true,
            'data' => $location->toArray(),
        ]);
    }

    public function test_location_can_be_updated(): void
    {
        $admin = User::factory()->create(['role' => 'admin']);
        $location = Location::factory()->create();

        $response = $this->actingAs($admin)->putJson("/api/locations/{$location->id}", [
            'name' => 'Updated Location Name',
        ]);

        $response->assertStatus(200);
        $this->assertDatabaseHas('locations', [
            'id' => $location->id,
            'name' => 'Updated Location Name',
        ]);
    }

